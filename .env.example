# Copy to .env and fill in. Not committed.

# From your Supabase project settings -> API.
SUPABASE_URL=https://xxxxxxxx.supabase.co

# The project owner uses the service_role key (full access, bypasses RLS).
# Never share this one.
SUPABASE_SERVICE_KEY=your-service-role-key

# Friends syncing into someone else's project use the anon key instead, in
# this variable (read + insert only, enforced by the RLS policies in
# supabase/schema.sql -- they can't read/write/delete anyone's data outside
# what those policies allow):
# SUPABASE_KEY=the-project-owners-anon-key

# Optional overrides, mostly useful for testing without the real game installed.
# BAZAAR_TRACKER_DATA_DIR=D:\path\to\local\data
# BAZAAR_PLAYER_LOG_PATH=D:\path\to\Player.log
